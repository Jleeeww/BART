# ── Copy to .env and fill in. Server won't boot without DATABASE_URL. ──

# REQUIRED — Postgres connection. Server throws at startup if missing (server/db.ts).
#
# Local Docker (default — matches docker-compose.yml):
DATABASE_URL=postgresql://bart:bart@localhost:5432/bart
#
# Or Neon cloud (works with the same node-postgres driver — keep sslmode=require):
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# OPTIONAL — AI engine (Claude). Needed for AI summaries/insights, not for charts.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OPTIONAL — secrets for the ingest pipeline and management routes.
INGEST_SECRET=
MANAGEMENT_TOKEN=

# OPTIONAL — server port (defaults to 5000).
PORT=5000

# NOTE: OHLCV chart data comes live from Yahoo Finance (.JK tickers) with no key.
# See server/engine/ohlcvFetcher.ts + GET /api/stocks/:symbol/ohlcv.
